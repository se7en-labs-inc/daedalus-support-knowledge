  "safety": {
    "risk": "medium",
    "flags": [
      "funds"
    ],
    "prerequisites": [
      "同期が完了しており、報酬とは別に、Daedalusが委任に必要と表示する最低額のADAが入っているウォレットを用意してください。"
    ],
    "consequences": [
      "手数料とデポジットがある場合は、その額がウォレットから支払われます。",
      "新しい委任が有効になるまでは、以前の委任が継続します。"
    ],
    "recovery": [
      "別のプールに変更する場合は、ウォレットの委任操作を再度行い、そのプールを選択してください。"
    ]
  },
