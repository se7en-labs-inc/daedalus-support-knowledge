  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "「ステーキング」を開き、「委任センター」を選択して、対象のウォレットの横にある「委任する」を選択してください。すでに委任している場合は「再設定する」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    },
    {
      "order": 2,
      "action": "「ウォレットを委任する」に表示される手順を確認し、「続ける」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    },
    {
      "order": 3,
      "action": "委任するウォレットが選択されていることを確認し、「続ける」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    },
    {
      "order": 4,
      "action": "最近選択したステークプールから選ぶか、一覧を検索してステークプールを選び、「続ける」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    },
    {
      "order": 5,
      "action": "Daedalusに表示されるステークプールIDと手数料を確認してください。",
      "why": "",
      "source_ids": [
        "SRC-0129",
        "SRC-0134",
        "SRC-0135"
      ]
    },
    {
      "order": 6,
      "action": "ソフトウェアウォレットの場合は、「委任を確認する」で送金時パスワードを入力し、「確認」を選択してください。代わりに「トランザクションを確認」が表示された場合は、そこでパスワードを入力し、「署名して送信」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129",
        "SRC-0134",
        "SRC-0135",
        "SRC-0140"
      ]
    },
    {
      "order": 7,
      "action": "ハードウェアウォレットの場合は、デバイス上でトランザクションを確認してから、「委任を確認する」で「確認」を選択してください。代わりに「トランザクションを確認」が表示された場合は、「デバイスで続行して送信」を選択し、デバイス上で確認してください。",
      "why": "",
      "source_ids": [
        "SRC-0129",
        "SRC-0134",
        "SRC-0135",
        "SRC-0140"
      ]
    }
  ],
  "expected_outcome": {
    "text": "Daedalus sends the delegation transaction, and the new delegation takes effect after the current and the next epoch have completed.",
    "source_ids": [
      "SRC-0129",
      "SRC-0135",
      "SRC-0140"
    ]
  },
