  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "daedaluswallet.io/downloadを開き、お使いのOS向けのインストーラーと、それに対応する.asc署名ファイルをダウンロードしてください。",
      "why": "",
      "source_ids": [
        "SRC-0120"
      ]
    },
    {
      "order": 2,
      "action": "Linuxでは、提供が終了する予定のポータブル.binインストーラーではなく、Debian、RPM、Archのパッケージ、またはflake内のNixOSサービスを選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0111"
      ]
    },
    {
      "order": 3,
      "action": "インストーラーを実行する前に、ダウンロードページの説明に従ってSHA256チェックサムと署名を検証してください。",
      "why": "",
      "source_ids": [
        "SRC-0120"
      ]
    }
  ],
  "expected_outcome": {
    "text": "You have an installer from daedaluswallet.io whose SHA256 checksum and signature match, ready to run.",
    "source_ids": [
      "SRC-0120"
    ]
  },
