  "schema_version": 1,
  "id": "DAE-1101",
  "title": "公式ウェブサイトからDaedalusをダウンロードする",
  "summary": {
    "text": "DaedalusはWindows、macOS、Linux向けのデスクトップアプリケーションです。ダウンロードサイトはdaedaluswallet.ioです。各インストーラーには対応する.asc署名ファイルが用意されており、実行前にインストーラーが正規のものであることを確認できます。",
    "source_ids": [
      "SRC-0120"
    ]
  },
  "problem": {
    "text": "A user needs to know where to download Daedalus safely and which Linux installation options exist.",
    "source_ids": [
      "SRC-0120"
    ]
  },
  "symptoms": [
    {
      "text": "The user is unsure which download site is genuine.",
      "source_ids": [
        "SRC-0120"
      ]
    }
  ],
  "user_phrases": [
    {
      "text": "Where do I download Daedalus?",
      "source_ids": [
        "SRC-0120"
      ]
    },
    {
      "text": "Is this Daedalus download real?",
      "source_ids": [
        "SRC-0120"
      ]
    }
  ],
