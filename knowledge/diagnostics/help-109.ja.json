  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "サポートポータルを開いてください。Daedalusの「ヘルプ」メニューで「サポートリクエスト」を選択するか、https://daedalus.support.se7enlabs.comにアクセスしてください。",
      "why": "",
      "source_ids": [
        "SRC-0115",
        "SRC-0117",
        "SRC-0128"
      ]
    },
    {
      "order": 2,
      "action": "ポータルから求められたら、メールアドレスの確認を行ってください。",
      "why": "",
      "source_ids": [
        "SRC-0118"
      ]
    },
    {
      "order": 3,
      "action": "まず、ポータルに表示されるサポート案内をお試しください。",
      "why": "",
      "source_ids": [
        "SRC-0118"
      ]
    },
    {
      "order": 4,
      "action": "それでも解決しない場合は、担当者によるサポートケースの作成に進み、問題の内容を説明してください。",
      "why": "",
      "source_ids": [
        "SRC-0118"
      ]
    },
    {
      "order": 5,
      "action": "Daedalusの「ヘルプ」メニューで「ログのダウンロード」を選択し、ダウンロードしたファイルをサポートケースに添付してください。",
      "why": "",
      "source_ids": [
        "SRC-0112",
        "SRC-0128"
      ]
    }
  ],
  "expected_outcome": {
    "text": "The portal's guidance solves the problem, or you have a support case, which you can return to later with Open an existing case.",
    "source_ids": [
      "SRC-0118"
    ]
  },
