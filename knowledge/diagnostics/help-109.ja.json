{
  "schema_version": 1,
  "id": "DAE-1109",
  "title": "サポートへの問い合わせ方法と問い合わせるタイミング",
  "summary": {
    "text": "サポートはhttps://daedalus.support.se7enlabs.comのサポートポータルで提供しています。お困りの問題がヘルプ記事で解決しなかった場合、Daedalusからサポートリクエストの送信を求められた場合、またはDaedalusに表示される受取アドレスがハードウェアウォレットに表示されるアドレスと異なる場合は、サポートケースを作成してください。",
    "source_ids": [
      "SRC-0112",
      "SRC-0115",
      "SRC-0118"
    ]
  },
  "problem": {
    "text": "A user needs help from a person and wants to know when to open a support case and where to ask.",
    "source_ids": [
      "SRC-0112",
      "SRC-0115",
      "SRC-0118"
    ]
  },
  "symptoms": [
    {
      "text": "The user cannot solve the problem with the FAQ.",
      "source_ids": [
        "SRC-0115",
        "SRC-0118"
      ]
    }
  ],
  "user_phrases": [
