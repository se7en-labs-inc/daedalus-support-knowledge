  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "「Cardanoノードから進捗状況が報告されていません」と表示された場合は、処理を待つために「このまま待つ」を選択してください。処理が停止していると思われる場合は「Cardanoノードを再起動」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0111",
        "SRC-0112"
      ]
    },
    {
      "order": 2,
      "action": "このコンピューターに保存されたブロックチェーンデータの一部が欠けているためCardanoノードを起動できないと表示された場合は、「ブロックチェーンデータを再構築」を選択し、「再構築」で確定してください。",
      "why": "",
      "source_ids": [
        "SRC-0111",
        "SRC-0112"
      ]
    },
    {
      "order": 3,
      "action": "Cardanoノードを起動できないとDaedalusに表示された場合は、「サポートチケットを作成する」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112",
        "SRC-0113",
        "SRC-0116"
      ]
    }
  ],
  "expected_outcome": {
    "text": "The Cardano node finishes starting, or you have opened a support case from Daedalus.",
    "source_ids": [
      "SRC-0111",
      "SRC-0112",
      "SRC-0116"
    ]
  },
  "do_not": [],
  "escalate_when": [],
  "safety": {
    "risk": "low",
    "flags": [
      "network"
    ],
    "prerequisites": [],
    "consequences": [
      "再構築すると、このコンピューターに保存されたブロックチェーンデータが削除され、検証済みの完全なデータが再ダウンロードされます。ダウンロードが完了するまでDaedalusは使用できません。ウォレットはこのコンピューターに保持されます。"
    ],
