{
  "schema_version": 1,
  "id": "DAE-1103",
  "title": "Cardanoノードの起動に関する問題を確認する",
  "summary": {
    "text": "Cardanoノードは起動時に、コンピューターに保存されたブロックチェーンデータの整合性を検証します。ノードから5分間応答がない場合、Daedalusは「Cardanoノードから進捗状況が報告されていません」と表示し、ノードがまだ処理中である可能性を案内します。",
    "source_ids": [
      "SRC-0111",
      "SRC-0112"
    ]
  },
  "problem": {
    "text": "Daedalus does not finish starting and the Cardano node shows no progress.",
    "source_ids": [
      "SRC-0111",
      "SRC-0112"
    ]
  },
  "symptoms": [
    {
      "text": "The loading screen says Starting Cardano node for a long time.",
      "source_ids": [
        "SRC-0111",
        "SRC-0112"
      ]
    }
  ],
  "user_phrases": [
    {
      "text": "Daedalus will not start",
      "source_ids": [
        "SRC-0111",
        "SRC-0112"
      ]
    },
    {
      "text": "Cardano node is not reporting progress",
      "source_ids": [
        "SRC-0111",
        "SRC-0112"
      ]
    }
  ],
  "errors": [],
