  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "Daedalusの「設定」で「ステークプール」を選択し、「オフチェーンメタデータサーバー（SMASH）」の設定を確認してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 2,
      "action": "「使用しない（直接データをフェッチする）」に設定されている場合は、「IOHK（推奨）」またはご自身で設定したサーバーを選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 3,
      "action": "「ヘルプ」メニューから「Daedalus診断」を開き、「Cardanoノード反応」と「Cardanoノード同期中」を確認してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 4,
      "action": "それでもDaedalusが正常に動作しない場合は、「ヘルプ」メニューで「ログのダウンロード」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0128"
      ]
    },
    {
      "order": 5,
      "action": "サポートポータルでケースを作成し、ご利用のセキュリティソフト名を記載してログを添付してください。",
      "why": "",
      "source_ids": [
        "SRC-0112",
        "SRC-0115",
        "SRC-0121"
      ]
    }
  ],
  "expected_outcome": {
    "text": "Daedalus fetches stake pool data through an off-chain metadata server, and Daedalus Diagnostics shows Cardano node responding and Cardano node syncing while your security software runs.",
    "source_ids": [
      "SRC-0112"
    ]
  },
