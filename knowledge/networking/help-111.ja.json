  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "「同期できません - 時刻の不一致」と表示された場合は、サポートポータルの記事『「同期できません - 時刻の不一致」を解消する』を参考に、コンピューターの時計を合わせてください。",
      "why": "",
      "source_ids": [
        "SRC-0112",
        "SRC-0114"
      ]
    },
    {
      "order": 2,
      "action": "その後、「もう一度時刻を確認する」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 3,
      "action": "「接続に問題がありますか」とともに「再試行」ボタンが表示された場合は、「再試行」を選択してCardanoノードの起動を再度お試しください。",
      "why": "",
      "source_ids": [
        "SRC-0113",
        "SRC-0116"
      ]
    },
    {
      "order": 4,
      "action": "それでもDaedalusが接続できない場合は、「ログをダウンロードする」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112",
        "SRC-0116"
      ]
    },
    {
      "order": 5,
      "action": "「サポートチケットを作成する」を選択し、サポートリクエストにログを添付してください。",
      "why": "",
      "source_ids": [
        "SRC-0115",
        "SRC-0116"
      ]
    }
  ],
  "expected_outcome": {
    "text": "Daedalus connects to the network and continues loading.",
    "source_ids": [
      "SRC-0112"
    ]
  },
