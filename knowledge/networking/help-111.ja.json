{
  "schema_version": 1,
  "id": "DAE-1111",
  "title": "「ネットワークに接続しています」が続く場合の確認方法",
  "summary": {
    "text": "Daedalusは、接続が確立するまで読み込み画面に「ネットワークに接続しています」と表示します。コンピューターの時刻が基準時刻から4.5秒を超えてずれている場合は同期できません。また、20分間接続できない場合は「接続に問題がありますか」と表示されます。",
    "source_ids": [
      "SRC-0112",
      "SRC-0113",
      "SRC-0114"
    ]
  },
  "problem": {
    "text": "Daedalus stays on the Connecting to network screen.",
    "source_ids": [
      "SRC-0112",
      "SRC-0113"
    ]
  },
  "symptoms": [
    {
      "text": "The loading screen says Connecting to network and does not move on.",
      "source_ids": [
        "SRC-0112",
        "SRC-0113"
      ]
    }
  ],
  "user_phrases": [
    {
      "text": "Daedalus stuck on connecting to network",
      "source_ids": [
        "SRC-0112",
        "SRC-0113"
      ]
    },
    {
      "text": "Having trouble connecting to network",
      "source_ids": [
        "SRC-0112",
        "SRC-0113"
      ]
    }
  ],
  "errors": [],
