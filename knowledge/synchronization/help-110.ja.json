  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "読み込み画面に「Mithrilによる高速同期」が表示された場合は、スナップショットを選び、「Mithril高速同期を使う」を選択してください。使用しない場合は「ジェネシスからのブロックチェーン同期」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 2,
      "action": "Daedalusの起動後にMithrilを利用する場合は、「ヘルプ」メニューから「Daedalus診断」を開き、「Mithril同期」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 3,
      "action": "ご自身で「Mithril同期」を開いた場合は、「Mithril同期を開始」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 4,
      "action": "「スナップショットをストレージに移動中」と表示されている間は、Daedalusを開いたままにしてください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 5,
      "action": "ブロックチェーンデータの破損が検出され、「Mithril同期」を利用できない場合は、代わりに「ブロックチェーンデータを再構築」を選択し、「再構築」で確定してください。",
      "why": "",
      "source_ids": [
        "SRC-0112",
        "SRC-0150"
      ]
    }
  ],
  "expected_outcome": {
    "text": "Daedalus restarts the Cardano node on the verified chain data, and the node syncs the remaining blocks.",
    "source_ids": [
      "SRC-0112"
    ]
  },
  "do_not": [],
