  "causes": [],
  "diagnostics": [
    {
      "order": 1,
      "action": "進行状況を確認するには、「ヘルプ」メニューから「Daedalus診断」を開き、「同期率」と「Cardanoノード同期中」を確認してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    }
  ],
  "resolutions": [
    {
      "order": 1,
      "action": "同期に時間がかかる場合は、「Daedalus診断」で「Mithril同期」を選択すると、検証済みのチェーンデータを復元できます。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 2,
      "action": "ブロックチェーンデータの一部が欠けているため同期を完了できないとDaedalusに表示された場合は、「ブロックチェーンデータを再構築」を選択し、「再構築」で確定してください。",
      "why": "",
      "source_ids": [
        "SRC-0111",
        "SRC-0112"
      ]
    }
  ],
  "expected_outcome": {
    "text": "You can see which loading stage Daedalus is in and how far the sync has progressed.",
    "source_ids": [
      "SRC-0112"
    ]
  },
  "do_not": [],
  "escalate_when": [],
  "safety": {
    "risk": "low",
    "flags": [
      "network"
    ],
    "prerequisites": [],
    "consequences": [
      "再構築すると、このコンピューターに保存されたブロックチェーンデータが削除され、検証済みの完全なデータが再ダウンロードされます。ダウンロードが完了するまでDaedalusは使用できません。ウォレットはこのコンピューターに保持されます。"
