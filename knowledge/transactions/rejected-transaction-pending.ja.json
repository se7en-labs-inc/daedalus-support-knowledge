  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "ウォレットの「トランザクション」を開いてください。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    },
    {
      "order": 2,
      "action": "「トランザクション処理中」と表示されているトランザクションを選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129",
        "SRC-0133"
      ]
    },
    {
      "order": 3,
      "action": "トランザクションが10分を超えて処理中のままになっている場合は、「処理中のトランザクションをキャンセルする」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129",
        "SRC-0133",
        "SRC-0146",
        "SRC-0147"
      ]
    },
    {
      "order": 4,
      "action": "「はい、トランザクションをキャンセルします」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129",
        "SRC-0133"
      ]
    },
    {
      "order": 5,
      "action": "代わりに「トランザクション失敗」と表示されている場合は、「失敗したトランザクションを削除する」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0129",
        "SRC-0133",
        "SRC-0147"
      ]
    },
    {
      "order": 6,
      "action": "再度送金した際にエラーが発生した場合は、繰り返し送金を試みず、サポートポータルでサポートケースを作成してください。拒否された送金も試行のたびに処理中として一覧に表示され、ウォレット内で使用できない資金がさらに増えます。",
      "why": "",
      "source_ids": [
        "SRC-0009",
        "SRC-0118",
        "SRC-0151"
      ]
    },
    {
      "order": 7,
      "action": "サポートケースを作成する際は、ログを添付してください。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    }
  ],
  "expected_outcome": {
    "text": "The transaction is no longer listed, and its funds can be spent again.",
    "source_ids": [
      "SRC-0129",
      "SRC-0133"
    ]
  },
