  "resolutions": [
    {
      "order": 1,
      "action": "サイドバーで選択されているウォレットが、資金のあるはずのウォレットか確認してください。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    },
    {
      "order": 2,
      "action": "ウォレットの「概要」にトランザクション履歴をブロックチェーンと同期中であると表示されている場合は、同期が完了するまでお待ちください。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    },
    {
      "order": 3,
      "action": "「トランザクション」を開いて対象のトランザクションを選択し、金額と「トランザクションID」を確認してください。送金したトランザクションでは「トランザクション手数料」、デポジットがある場合は「デポジット」も確認できます。",
      "why": "",
      "source_ids": [
        "SRC-0133",
        "SRC-0129"
      ]
    }
  ],
  "expected_outcome": {
    "text": "You can see each transaction's amount, fee and any deposit in the wallet that holds it.",
    "source_ids": [
      "SRC-0129",
      "SRC-0133"
    ]
  },
