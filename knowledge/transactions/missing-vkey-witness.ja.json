  "resolutions": [
    {
      "order": 1,
      "action": "secret.keyファイルの入手元を確認してください。自分のウォレットの鍵が含まれているのは、自分自身が旧バージョンのDaedalusで作成したファイルだけです。",
      "why": "",
      "source_ids": [
        "SRC-0129"
      ]
    },
    {
      "order": 2,
      "action": "他人からそのファイルを譲り受けた、購入した、または送られてきた場合は、そのウォレットからの送金を試みないでください。",
      "why": "",
      "source_ids": [
        "SRC-0004",
        "SRC-0148",
        "SRC-0149"
      ]
    }
  ],
  "expected_outcome": {
    "text": "You pay nothing for a wallet whose funds the file cannot spend.",
