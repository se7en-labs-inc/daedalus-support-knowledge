  "causes": [],
  "diagnostics": [],
  "resolutions": [
    {
      "order": 1,
      "action": "「ウォレット追加」を選択し、次に「ペアリング」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 2,
      "action": "デバイスを接続し、デバイス上でPINを入力してロックを解除してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 3,
      "action": "Daedalusから求められたら、デバイス上でCardanoアプリケーションを起動してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 4,
      "action": "Daedalusから求められたら、デバイス上で公開鍵をエクスポートしてください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 5,
      "action": "ウォレット名を入力し、「ウォレットをペアリングする」を選択してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 6,
      "action": "ペアリングに失敗した場合は、デバイスを取り外して再接続し、操作を最初からやり直してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 7,
      "action": "Trezor BridgeがインストールされていないとDaedalusに表示された場合は、「インストールガイド」のリンクからインストールしてください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "order": 8,
      "action": "「Ledgerソフトウェアは期限切れです。」または「サポートされていないファームウェアです。」と表示された場合は、メッセージの横にあるリンクからデバイスを更新してください。",
      "why": "",
      "source_ids": [
        "SRC-0112"
      ]
    }
  ],
  "expected_outcome": {
    "text": "The device's wallet appears in Daedalus under the name you gave it, and you connect the device only to confirm transactions.",
    "source_ids": [
      "SRC-0112"
    ]
  },
