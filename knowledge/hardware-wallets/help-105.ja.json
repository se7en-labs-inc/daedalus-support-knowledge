{
  "schema_version": 1,
  "id": "DAE-1105",
  "title": "ハードウェアウォレットをDaedalusに接続する",
  "summary": {
    "text": "DaedalusはLedger Nano S、Ledger Nano S Plus、Ledger Nano X、Ledger Flex、Trezor Model Tに対応しています。デバイスのペアリングは一度だけ行い、その後はトランザクションの承認が必要なときに接続します。",
    "source_ids": [
      "SRC-0112"
    ]
  },
  "problem": {
    "text": "A Ledger or Trezor device does not connect to Daedalus.",
    "source_ids": [
      "SRC-0112"
    ]
  },
  "symptoms": [
    {
      "text": "Daedalus does not show the device as ready.",
      "source_ids": [
        "SRC-0112"
      ]
    }
  ],
  "user_phrases": [
    {
      "text": "My Ledger is not connecting",
      "source_ids": [
        "SRC-0112"
      ]
    },
    {
      "text": "Daedalus does not see my Trezor",
      "source_ids": [
        "SRC-0112"
      ]
    }
  ],
  "errors": [],
