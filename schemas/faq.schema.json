{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "knowledge_entries",
          "status",
          "answer"
        ],
        "properties": {
          "id": {
            "pattern": "^FAQ-[0-9]{3}$",
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "knowledge_entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "published",
              "draft",
              "retired"
            ]
          },
          "answer": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "text",
                "source_ids"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^SRC-[0-9]{4}$"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "locale": {
            "enum": [
              "en",
              "ja"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "translates": {
            "type": "object",
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^FAQ-[0-9]{3}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "locale"
              ],
              "properties": {
                "locale": {
                  "const": "ja"
                }
              }
            },
            "then": {
              "required": [
                "translates"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
