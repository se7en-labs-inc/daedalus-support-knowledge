{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ariadne knowledge entry",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "problem",
    "symptoms",
    "user_phrases",
    "classification",
    "applicability",
    "causes",
    "diagnostics",
    "resolutions",
    "expected_outcome",
    "do_not",
    "escalate_when",
    "safety",
    "evidence",
    "lifecycle",
    "dates",
    "sources",
    "related_entries",
    "faq",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "pattern": "^DAE-[0-9]{4}$",
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 12
    },
    "summary": {
      "$ref": "#/$defs/claim"
    },
    "problem": {
      "$ref": "#/$defs/claim"
    },
    "symptoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "user_phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verbatim",
          "normalized"
        ],
        "properties": {
          "verbatim": {
            "type": "string"
          },
          "normalized": {
            "type": "string"
          },
          "pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": "string"
        },
        "additionalProperties": false
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "category",
        "subcategory"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "subcategory": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": [
        "daedalus",
        "operating_systems",
        "networks",
        "hardware_wallets",
        "source_ids"
      ],
      "properties": {
        "daedalus": {
          "type": "object",
          "required": [
            "scope",
            "min",
            "max",
            "versions",
            "introduced_in",
            "first_known_affected",
            "last_known_affected",
            "fixed_in",
            "notes"
          ],
          "properties": {
            "scope": {
              "enum": [
                "universal",
                "range",
                "specific",
                "before",
                "after",
                "unknown"
              ]
            },
            "min": {
              "type": [
                "string",
                "null"
              ]
            },
            "max": {
              "type": [
                "string",
                "null"
              ]
            },
            "versions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "introduced_in": {
              "type": [
                "string",
                "null"
              ]
            },
            "first_known_affected": {
              "type": [
                "string",
                "null"
              ]
            },
            "last_known_affected": {
              "type": [
                "string",
                "null"
              ]
            },
            "fixed_in": {
              "type": [
                "string",
                "null"
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "operating_systems": {
          "type": "object",
          "required": [
            "scope",
            "values"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "all",
                "specific",
                "unknown",
                "not_applicable"
              ]
            },
            "values": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "windows",
                  "macos",
                  "linux"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "networks": {
          "type": "object",
          "required": [
            "scope",
            "values"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "all",
                "specific",
                "unknown",
                "not_applicable"
              ]
            },
            "values": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "mainnet",
                  "preview",
                  "preprod"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "hardware_wallets": {
          "type": "object",
          "required": [
            "scope",
            "values"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "all",
                "specific",
                "unknown",
                "not_applicable"
              ]
            },
            "values": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "claim",
          "source_ids"
        ],
        "properties": {
          "kind": {
            "enum": [
              "confirmed",
              "suspected",
              "unknown"
            ]
          },
          "claim": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "expected_outcome": {
      "$ref": "#/$defs/claim"
    },
    "do_not": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalate_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "risk",
        "flags",
        "prerequisites",
        "consequences",
        "recovery"
      ],
      "properties": {
        "risk": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "deletes-files",
              "resets-state",
              "reinstall",
              "moves-wallet-data",
              "restore",
              "permissions",
              "terminal",
              "firewall",
              "antivirus",
              "network",
              "hardware-wallet",
              "wallet-recovery",
              "funds"
            ]
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "classification",
        "confidence",
        "rationale",
        "conflicts"
      ],
      "properties": {
        "classification": {
          "enum": [
            "officially-documented",
            "maintainer-confirmed",
            "independently-confirmed",
            "single-user-confirmed",
            "plausible-unverified",
            "conflicting",
            "deprecated",
            "known-incorrect",
            "unsafe"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status",
        "superseded_by",
        "merged_into",
        "reason",
        "source_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "active",
            "historical",
            "superseded",
            "deprecated",
            "unverified",
            "unsafe",
            "incorrect",
            "merged"
          ]
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "merged_into": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dates": {
      "type": "object",
      "required": [
        "created",
        "last_reviewed",
        "last_verified"
      ],
      "properties": {
        "created": {
          "type": "string",
          "format": "date"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "related_entries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "faq": {
      "type": "object",
      "required": [
        "eligible",
        "promoted",
        "reason"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "promoted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "order",
        "action",
        "why",
        "source_ids"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "text",
        "source_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^SRC-[0-9]{4}$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
